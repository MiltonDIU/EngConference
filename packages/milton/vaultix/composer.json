{
    "name": "milton/vaultix",
    "description": "Dynamic, admin-managed backup system for Laravel (GDrive, S3, R2).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0",
        "spatie/laravel-backup": "^9.0",
        "masbug/flysystem-google-drive-ext": "^1.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-sftp-v3": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Milton\\Vaultix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Milton\\Vaultix\\VaultixServiceProvider"
            ]
        }
    }
}
