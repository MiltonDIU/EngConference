{
    "name": "codexalta/vaultix",
    "description": "Enterprise-grade Dynamic Backup System for Laravel with Admin Dashboard, Smart Storage Projection, and Multi-provider Support.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Codexalta",
            "email": "info@codexalta.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-backup": "^9.0|^10.0",
        "masbug/flysystem-google-drive-ext": "^2.5",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-sftp-v3": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Codexalta\\Vaultix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codexalta\\Vaultix\\VaultixServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
